# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database - MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/campus_marketplace?retryWrites=true&w=majority

# Authentication - JWT & Admin Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=sahil@ecom.iust
ADMIN_PASSWORD=sahil123

# Media Storage - Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email - SMTP Credentials (e.g., Mailtrap, SendGrid, Gmail App Password)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Campus Marketplace <noreply@campusmarketplace.edu>"
